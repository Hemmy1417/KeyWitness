# KeyWitness needs no secrets to run: there is no server, no database and no
# operator key. Reads go from the browser to Studio Next and every write is
# signed by the visitor's own wallet. These settings are all optional and all
# public (NEXT_PUBLIC_ values are compiled into the page).
#
# Copy to web/.env.local to use them.

# Point the app at another KeyWitness deployment than the one in web/lib/config.ts.
NEXT_PUBLIC_KEYWITNESS_CONTRACT=

# The live run of the synthetic sample on that deployment (a case id such as KW-0003).
NEXT_PUBLIC_KEYWITNESS_SAMPLE_CASE=

# Another GenLayer network. Leave empty for Studio Next (chain 61997).
NEXT_PUBLIC_GENLAYER_RPC_URL=
NEXT_PUBLIC_GENLAYER_CHAIN_ID=
NEXT_PUBLIC_GENLAYER_EXPLORER_URL=

# Scripts only (scripts/*.mjs): the RPC to deploy to and prove against.
# Their signing keys are generated into .data/keys.json, which is gitignored
# and never printed; nothing here is a key.
GENLAYER_RPC_URL=
